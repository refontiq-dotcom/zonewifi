# ============================================================
# ZoneWifi — Variables d'environnement
# Copiez ce fichier en .env.local et renseignez les valeurs
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Nouveau format Supabase (remplace l'ancien ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# Secret pour valider les requêtes webhook entrantes
TELEGRAM_WEBHOOK_SECRET=your_random_secret_string_here

# --- Liens Wave Business (montant fixe par forfait) ---
NEXT_PUBLIC_WAVE_URL_3J=https://pay.wave.com/m/xxxxxxxx?amount=500
NEXT_PUBLIC_WAVE_URL_1S=https://pay.wave.com/m/xxxxxxxx?amount=1000
NEXT_PUBLIC_WAVE_URL_2S=https://pay.wave.com/m/xxxxxxxx?amount=1500
NEXT_PUBLIC_WAVE_URL_1M=https://pay.wave.com/m/xxxxxxxx?amount=3000

# --- URL du portail (pour construire les liens dans les messages Telegram) ---
NEXT_PUBLIC_APP_URL=https://votre-domaine.vercel.app
